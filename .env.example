
# Azure OpenAI (required for LLM comparison modes)
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_ENDPOINT=
# AZURE_OPENAI_DEPLOYMENT=

# Redis job store (optional — omit to use in-memory store with TTL cleanup)
# Local:      REDIS_URL=redis://localhost:6379
# Docker:     REDIS_URL=redis://redis:6379
# ElastiCache: REDIS_URL=redis://<cluster-endpoint>:6379
# REDIS_URL=

# API tuning
# MAX_WORKERS=4          # ThreadPoolExecutor threads for comparisons
# JOB_TTL_SECONDS=3600   # How long completed jobs are kept before auto-deletion

# Windows: Tesseract OCR binary must be installed for scanned PDF support
# Download: https://github.com/UB-Mannheim/tesseract/wiki
# If installed to a non-default path, set:
# TESSDATA_PREFIX=C:\Program Files\Tesseract-OCR
